# =========================================================
# FundAdvisor 环境变量示例 (复制为 .env 后填写真实值)
# ⚠️ 真实 .env 已被 .gitignore 忽略, 切勿提交
# =========================================================

# ---------- Database (MySQL) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fund_advisor

# ---------- Application ----------
APP_ENV=development
APP_PORT=8200

# ---------- NAV Fetch (净值抓取) ----------
NAV_FETCH_CONCURRENCY=5
NAV_FETCH_INTERVAL=0.5

# ---------- NewAPI / LLM Gateway (OpenAI 兼容接口) ----------
# 如无自建网关, 可填任意 OpenAI 兼容服务的地址与 Key(如 DeepSeek / 中转站)
NEWAPI_BASE_URL=https://your-llm-gateway.example.com/v1
NEWAPI_API_KEY=your_llm_api_key

# ---------- SMTP (邮件推送) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_TO=recipient@example.com

# ---------- 可选: 决策引擎参数 (不填用默认) ----------
# TARGET_VOL=0.15            # 目标年化波动率(十进制): 进取0.20/保守0.10
# DD_HARD_STOP_PCT=25.0      # 回撤>25%清仓
# DD_REDUCE_LO_PCT=15.0      # 回撤15-25%减仓
# VOL_HIGH_CAP_PCT=60.0      # 年化波动>60%压仓
# CONC_CAP=0.50              # 单基金目标权重上限
# BEAR_CAP=0.30              # 熊市防御上限
# FRICTION_BAND_PP=5.0       # 换手触发带(百分点)
