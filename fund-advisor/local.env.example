# 仅供本地合成数据环境使用；复制为 .env 后不会被 Git 提交。
# 这些密码只保护绑定在 127.0.0.1:3307 的本地测试容器，不得用于服务器。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=fund_test
DB_PASSWORD=local-test-only
DB_NAME=fund_advisor_test

APP_ENV=local
APP_PORT=8200

NAV_FETCH_CONCURRENCY=2
NAV_FETCH_INTERVAL=1.0
ENABLE_SCHEDULER=false
ENABLE_STARTUP_NAV_CHECK=false

# 本地默认关闭外部 LLM 和邮件能力，避免测试误调用外部服务。
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# 风控参数保持代码默认值；参数研究必须在独立实验中进行。
TARGET_VOL=0.15
DD_HARD_STOP_PCT=20.0
DD_REDUCE_LO_PCT=15.0
VOL_HIGH_CAP_PCT=60.0
CONC_CAP=0.50
BEAR_CAP=0.30
FRICTION_BAND_PP=5.0
