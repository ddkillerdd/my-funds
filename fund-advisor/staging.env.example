# staging 运行时模板；真实密码、LLM Key 和 SMTP 凭据只在服务器注入，不提交到 Git。
DB_HOST=mysql
DB_PORT=3306
DB_USER=fund_staging
DB_PASSWORD=
DB_NAME=fund_advisor_staging

APP_ENV=staging
APP_PORT=8200

NAV_FETCH_CONCURRENCY=2
NAV_FETCH_INTERVAL=1.0
ENABLE_SCHEDULER=false
ENABLE_STARTUP_NAV_CHECK=false

# 默认关闭外部模型和邮件；如需联调，必须使用单独的非生产凭据。
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
