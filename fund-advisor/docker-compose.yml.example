services:
  backend:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "8200:8200"
    env_file:
      - .env
    volumes:
      - ./data:/app/data
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    ports:
      - "8201:80"
    depends_on:
      - backend
    restart: unless-stopped
