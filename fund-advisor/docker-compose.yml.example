services:
  backend:
    build:
      context: ..
      dockerfile: fund-advisor/Dockerfile
    ports:
      - "127.0.0.1:8200:8200"
    env_file:
      - .env
    volumes:
      - ./data:/app/fund-advisor/data
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    ports:
      - "127.0.0.1:8201:80"
    depends_on:
      - backend
    restart: unless-stopped
