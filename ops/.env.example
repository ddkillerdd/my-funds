# SSH 连接信息；实际值写入同目录 .env，该文件不会提交到 Git
SSH_HOST=server.example.com
SSH_USER=deploy
SSH_PORT=22

# 可选：填写本机私钥文件的绝对路径，只填写路径，不复制私钥内容
SSH_IDENTITY_FILE=

# 安全策略：默认必须预先核对并登记 SSH 主机指纹
SSH_STRICT_HOST_KEY_CHECKING=yes

# 服务器上的 Git 仓库绝对路径
REMOTE_PROJECT_PATH=/srv/my-funds

# 以下信息供后续生成部署与健康检查脚本使用
DEPLOY_MODE=unknown
FRONTEND_URL=https://funds.example.com
BACKEND_HEALTH_URL=https://funds.example.com/api/health
